{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1 · Instalar dependencias",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pip", "install", "-r", "requirements.txt"],
      "problemMatcher": []
    },
    {
      "label": "2 · Pruebas locales",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "unittest", "-v"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "3 · Ejecutar demo con debug",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["main.py", "--debug"],
      "problemMatcher": []
    }
  ]
}
